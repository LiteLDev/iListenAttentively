#include "ila/base/Version.h"
#include <winres.h>

#pragma code_page(65001)

VS_VERSION_INFO VERSIONINFO
    FILEVERSION IL_VERSION_MAJOR, IL_VERSION_MINOR, IL_VERSION_PATCH
    PRODUCTVERSION IL_VERSION_MAJOR, IL_VERSION_MINOR, IL_VERSION_PATCH
    FILEFLAGSMASK 0x3fL
    FILEFLAGS IL_FILE_VERSION_FLAG
    FILEOS 0x40004L
    FILETYPE 0x2L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "MiracleForest"
            VALUE "FileDescription", "iListenAttentively is a rich and modern LeviLamina Minecraft event library!"
            VALUE "FileVersion", IL_FILE_VERSION_STRING
            VALUE "InternalName", "iListenAttentively.dll"
            VALUE "OriginalFilename", "iListenAttentively.dll"
            VALUE "ProductName", "iListenAttentively"
            VALUE "ProductVersion", IL_FILE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
